{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PRAVHA (Chrome Web)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=.env",
        "--web-port=5000"
      ]
    },
    {
      "name": "PRAVHA (Mobile / Default Device)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "PRAVHA (Release Build)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--dart-define-from-file=.env"
      ]
    }
  ]
}
