# ==============================================================================
# PRAVHA Transit App - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` on your local laptop:
#   cp .env.example .env
#
# Then fill in your own private API keys in `.env`.
# NEVER commit the `.env` file to Git or upload it to GitHub!
# ==============================================================================

# 1. Google Maps Platform API Key
# Required for Directions routing, places autocomplete, and street polylines.
# Obtain from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 2. Supabase Cloud Backend (PostgreSQL & Authentication)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Google Gemini AI API Key
# Required for live transit routing assistant and commuter inquiries.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Razorpay Payment Gateway (Test Mode)
# Required for in-app ticket and concession pass fare payment simulation.
# Obtain from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
